# Browser-visible configuration. Replace with credentials from the new project after backend migration.
VITE_APP_BASE_URL=http://localhost:5194
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-public-anon-key
# Use only if the Supabase project issues a publishable key instead of an anon key.
VITE_SUPABASE_PUBLISHABLE_KEY=
# Development-only visual preview. Production builds ignore this flag even if set.
VITE_DEMO_SUPPORT_ACCESS=false
VITE_ENABLE_ADMIN_SHORTCUT=false
VITE_DEV_ADMIN_BYPASS=false

# Server-only Netlify configuration. Never prefix these with VITE_.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_APP_PASSWORD=
NOTIFICATION_DISPATCH_SECRET=
ADMIN_EMAIL=admin@example.com
APP_NAME=DHL Express redesign concept
APP_URL=https://your-new-domain.example
TRACKING_URL=https://your-new-domain.example/track
SUPPORT_URL=https://your-new-domain.example/chat
LOGO_URL=https://your-new-domain.example/dhl-concept-logo.svg
LOCAL_APP_URL=http://localhost:5194
EMAIL_LINK_BASE_URL=
EMAIL_TEST_MODE=false
EMAIL_TEST_RECIPIENT=
