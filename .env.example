# Environment variables for Vite
# change values as appropriate for production
VITE_API_URL=https://api.yourdomain.com
VITE_APP_BASE_URL=https://yourdomain.com
# Supabase configuration (get from https://app.supabase.com)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your_public_anon_key
# Optional (if your project provides a publishable key instead of anon)
VITE_SUPABASE_PUBLISHABLE_KEY=your_publishable_key

# Server-only transactional email configuration. Set these in Netlify; do not
# prefix them with VITE_ and never expose them to browser code.
# Optional server override; the worker otherwise uses VITE_SUPABASE_URL.
SUPABASE_URL=
# Create a server-only `sb_secret_...` key in Supabase. Never prefix it with VITE_.
SUPABASE_SECRET_KEY=
# Legacy fallback only; leave blank when SUPABASE_SECRET_KEY is used.
SUPABASE_SERVICE_ROLE_KEY=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=buskelogistics141@gmail.com
SMTP_APP_PASSWORD=
# Shared only between the Supabase database webhook and the immediate Netlify
# dispatcher. Store the counterpart in Supabase Vault, never in VITE_.
NOTIFICATION_DISPATCH_SECRET=
ADMIN_EMAIL=buskelogistics141@gmail.com
APP_NAME=Buske Logistics
# Canonical production URL: normal customer email always uses this URL.
APP_URL=https://buskelogistics.netlify.app
TRACKING_URL=https://buskelogistics.netlify.app/track
SUPPORT_URL=https://buskelogistics.netlify.app/chat
# The deployed public logo. Email clients cannot load a localhost image URL.
LOGO_URL=https://buskelogistics.netlify.app/buske-logo.jpeg
# Local links are used only with EMAIL_TEST_RECIPIENT, so production emails
# continue to use APP_URL after deployment.
LOCAL_APP_URL=http://localhost:5173
# Optional direct CTA override, useful for a staging site.
EMAIL_LINK_BASE_URL=
# Optional: directs every email to this controlled mailbox during a production
# test. Remove it after testing so normal customer delivery resumes.
EMAIL_TEST_RECIPIENT=
