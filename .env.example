# Names and safe placeholders only. Real values are supplied at deployment
# (docs/phase-2-deployment.md). Never commit a filled-in copy of this file.

# ---------------------------------------------------------------------------
# Browser-visible configuration (VITE_*). Anything here ships to every visitor,
# so it must never contain a secret.
# ---------------------------------------------------------------------------
VITE_APP_BASE_URL=https://trackshipmentpro.netlify.app
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-public-anon-key
# Use only if the Supabase project issues a publishable key instead of an anon key.
VITE_SUPABASE_PUBLISHABLE_KEY=
# Optional bootstrap WhatsApp number (international digits, e.g. 15550000000).
# Used only until Admin > Settings > WhatsApp saves a number. Not a secret.
VITE_WHATSAPP_NUMBER=
# Optional override for the server functions path (default /.netlify/functions).
VITE_SERVER_FUNCTIONS_BASE=

# Development-only switches. Production builds ignore them even if set.
VITE_ENABLE_DEMO_SHIPMENT=false
VITE_ENABLE_ADMIN_SHORTCUT=false
VITE_DEV_ADMIN_BYPASS=false
VITE_SETTINGS_DEV_ADAPTER=false
# Local visual preview only. Production protection is the Netlify Edge gate.
VITE_HUMAN_GATE_LOCAL_PREVIEW=false

# ---------------------------------------------------------------------------
# Server-only Netlify configuration. Never prefix these with VITE_.
# ---------------------------------------------------------------------------
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# SMTP (Gmail: smtp.gmail.com / 465 / true, with a 16-letter Google App Password).
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_APP_PASSWORD=
# Shared secret between the database webhook and dispatch-notifications.
NOTIFICATION_DISPATCH_SECRET=
# Required on Netlify for the human-verification gate. Use one random value of
# at least 32 characters in the server-only environment; never commit it.
DEMO_GATE_SECRET=
# Only if Part Two stores the dashboard SMTP credential with app-level
# encryption instead of Supabase Vault. Leave empty when using Vault.
SETTINGS_ENCRYPTION_KEY=
ADMIN_EMAIL=shop1960c@gmail.com
APP_NAME=Shipment Tracking
APP_URL=https://trackshipmentpro.netlify.app
TRACKING_URL=https://trackshipmentpro.netlify.app/track
SUPPORT_URL=https://trackshipmentpro.netlify.app/chat
LOGO_URL=https://trackshipmentpro.netlify.app/dhl-concept-logo.svg
LOCAL_APP_URL=http://localhost:5194
EMAIL_LINK_BASE_URL=https://trackshipmentpro.netlify.app
EMAIL_TEST_MODE=false
EMAIL_TEST_RECIPIENT=
